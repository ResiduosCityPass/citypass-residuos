{
  "type": "record",
  "name": "IntervencionProgramada",
  "namespace": "com.citypass.residuos",
  "doc": "Residuos programo una intervencion en el lugar de una emergencia cuya causa fue residuos (CU-01 de Emergencias, A7).",
  "fields": [
    {
      "name": "intervencionId",
      "type": "string"
    },
    {
      "name": "emergenciaId",
      "type": "string"
    },
    {
      "name": "contenedorId",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Contenedor a menos de 50 m, si habia alguno."
    },
    {
      "name": "latitud",
      "type": "double"
    },
    {
      "name": "longitud",
      "type": "double"
    },
    {
      "name": "programadaEn",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Epoch en milisegundos."
    },
    {
      "name": "correlationId",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Igual al emergenciaId."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Epoch en milisegundos."
    }
  ]
}
