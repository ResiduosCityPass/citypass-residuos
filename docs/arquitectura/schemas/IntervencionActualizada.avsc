{
  "type": "record",
  "name": "IntervencionActualizada",
  "namespace": "com.citypass.residuos",
  "doc": "Una parada pendiente de una ruta asignada o en curso quedo afectada por una emergencia vial o por una suspensión climática confirmada en Residuos. Una intervención es una parada. BI cuenta camionId distintos por causaId y causaTipo (INCIDENTE_VIAL o EVENTO_CLIMATICO), no la cantidad de mensajes.",
  "fields": [
    { "name": "intervencionId", "type": "string", "doc": "Id de la parada: para Analitica, cada parada es una intervencion." },
    { "name": "camionId", "type": "string", "doc": "Patente del camion. Identifica a la cuadrilla: es la clave para contar." },
    { "name": "estadoAnterior", "type": "string", "doc": "PROGRAMADA." },
    { "name": "estadoNuevo", "type": "string", "doc": "AFECTADA." },
    { "name": "causaId", "type": ["null", "string"], "default": null, "doc": "Id de la causa externa: incidenteId informado por Emergencias para INCIDENTE_VIAL; alertaId de Espacios Públicos para EVENTO_CLIMATICO. Null si la emergencia no trae causa." },
    { "name": "causaTipo", "type": ["null", "string"], "default": null, "doc": "EVENTO_CLIMATICO en una suspensión climática; el valor recibido de Emergencias en los cortes viales. Null si y solo si causaId es null." },
    { "name": "correlationId", "type": ["null", "string"], "default": null, "doc": "alertaId de Espacios Públicos para clima. En emergencias se conserva correlationId o, si falta, emergenciaId." },
    { "name": "updatedAt", "type": "string", "doc": "Momento en que la parada quedo afectada, en ISO-8601 UTC." }
  ]
}
