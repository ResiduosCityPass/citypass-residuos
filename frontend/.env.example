# URL base de la API del backend. En desarrollo el backend corre en el 3000.
VITE_API_URL=http://localhost:3000/api/v1

# Datos de demostracion en memoria, sin backend ni token (src/mocks/).
# Andamiaje temporal para disenar las pantallas: se apaga al conectarlas.
VITE_USE_MOCKS=false

# CU-10 · Permite confirmar una parada usando la posicion del contenedor en vez
# de la del GPS. Es un bypass del unico control que tiene el caso de uso, asi
# que viene apagado y NO se prende en ningun entorno que no sea una demo: los
# contenedores del seed estan en el Obelisco y quien prueba esta a kilometros.
VITE_SIMULAR_GPS=false

# Token de desarrollo. Si esta definida, la app la carga sola al arrancar y no
# hay que pegar el JWT a mano en cada vencimiento (duran 8 h). Se genera con:
#   cd backend && npm run token:dev -- ADMINISTRADOR
#
# Solo tiene efecto en `npm run dev`: Vite pone import.meta.env.DEV en false al
# compilar, asi que el bloque que la lee no llega al bundle de produccion.
# Vacia por defecto y `.env.local` no se versiona, asi que un clon del repo no
# hereda el token de nadie.
VITE_DEV_TOKEN=

# Token de desarrollo para la pantalla del chofer (CU-10), que exige rol CHOFER.
# La app elige solo cual de los dos usar segun la pantalla.
#   cd backend && npm run token:dev -- CHOFER
VITE_DEV_TOKEN_CHOFER=
