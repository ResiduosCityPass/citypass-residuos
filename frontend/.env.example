# URL base de la API del backend. En desarrollo el backend corre en el 3000.
VITE_API_URL=http://localhost:3000/api/v1

# Datos de demostracion en memoria, sin backend ni token (src/mocks/).
# Andamiaje temporal para disenar las pantallas: se apaga al conectarlas.
VITE_USE_MOCKS=false

# CU-10 · Permite confirmar una parada usando la posicion del contenedor en vez
# de la del GPS. Es un bypass del unico control que tiene el caso de uso, asi
# que viene apagado y NO se prende en ningun entorno que no sea una demo: los
# contenedores del seed estan en el Obelisco y quien prueba esta a kilometros.
VITE_SIMULAR_GPS=false
