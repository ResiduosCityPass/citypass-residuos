# Perfil local para Login real + Kafka/EDA real. Copiar a .env.integration.local (ignorado).
NODE_ENV=development
PORT=3038
API_PREFIX=api/v1
DB_HOST=127.0.0.1
DB_PORT=55433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=residuos_integracion_real_demo
DB_SSL=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
JWT_SECRET=REEMPLAZAR_POR_SECRETO_LOCAL_EXCLUSIVO_DE_RESIDUOS
JWT_ISSUER_CHOFERES=citypass-residuos-choferes
JWT_EXPIRES_IN=8h
JWT_ALGORITHM=HS256
AUTH_MODE=federated
JWT_ISSUER=https://idp.citypass.local
JWT_AUDIENCE=citypass-residuos-api
JWT_MODULE=residuos
JWT_JWKS_URL=https://api.citypass-login.pp.ua/.well-known/jwks.json
JWT_ADMIN_GROUPS=administrador
JWT_OPERATOR_GROUPS=operador,delegados
JWT_DRIVER_GROUPS=chofer
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CLIMA_SIMULADOR_HABILITADO=false
EVENT_BUS_DRIVER=platform
EDA_GATEWAY_URL=https://test.citypass.mrfranco.net.ar/api/v1
EDA_AUTH_URL=https://api.citypass-login.pp.ua
EDA_TOKEN_ISSUER=https://idp.citypass.local
EDA_CLIENT_ID=grupo6
EDA_CLIENT_SECRET=
EDA_NAMESPACE=com.citypass.residuos
EDA_CONSUMER_ENABLED=true
# Opt-in local para publicar/recibir los dos tipos SimulacroClimatico de Residuos.
# Primero: ENV_FILE=.env.integration.local npm run eda:simulacro -- registrar --apply
EDA_CLIMA_SIMULACRO_ENABLED=false
EDA_KAFKA_BROKERS=test.citypass.mrfranco.net.ar:9092
EDA_KAFKA_SSL=true
EDA_KAFKA_GROUP_ID=com.citypass.residuos.residuos-clima-local-v1
EDA_KAFKA_FROM_BEGINNING=true
