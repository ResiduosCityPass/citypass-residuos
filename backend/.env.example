# --- Aplicacion ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Base de datos (ver infra/docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=citypass
DB_PASSWORD=citypass
DB_NAME=residuos
# Alternativa para cloud/CI: usar una URL completa en lugar de las variables
# separadas de arriba.
DATABASE_URL=
# true solo para conexiones externas que requieren TLS, por ejemplo desde una
# maquina local contra la External Database URL de Render.
DB_SSL=false
# Deja que TypeORM cree el esquema solo. Apagado: el esquema lo definen las
# migraciones (ADR-002). Encenderlo pisa lo que hagan las migraciones y hace
# que dos maquinas terminen con esquemas distintos sin que nadie se entere.
DB_SYNCHRONIZE=false

# Corre las migraciones pendientes al arrancar la aplicacion. Comodo en un
# entorno desplegado; en local se prefiere `npm run migration:run` a mano.
DB_MIGRATIONS_RUN=false

# Base separada para los tests de integracion. Se crea sola si no existe.
DB_NAME_TEST=residuos_test

# --- Event bus (ADR-003) ---
# inmemory | rabbitmq | platform
EVENT_BUS_DRIVER=inmemory
RABBITMQ_URL=amqp://citypass:citypass@localhost:5672
EVENT_BUS_EXCHANGE=citypass.events

# Gateway del Squad 1 (CU-INT-01). Solo se usan con EVENT_BUS_DRIVER=platform.
# GATEWAY_URL=http://localhost:8080
# GATEWAY_TOKEN_URL=http://localhost:8083/oauth/token
# GATEWAY_CLIENT_ID=svc-residuos
# GATEWAY_CLIENT_SECRET=

# Secreto de la URL del webhook POST /webhooks/citypass?token=... Se usa con cualquier
# driver: vacio, el webhook rechaza todo (tambien la demo de simulator/reclamo.js).
GATEWAY_WEBHOOK_TOKEN=webhook-local

# Consumir el bus por Kafka (lo que recomienda EDA). Usa GATEWAY_CLIENT_ID/SECRET para el
# SASL y GATEWAY_URL como Schema Registry. Vacio: solo se consume por el webhook.
# KAFKA_BROKERS=localhost:9092
# KAFKA_SSL=false

# --- Identidad (ADR-005 + docs/arquitectura/contrato-identidad-token.md) ---
# Sprints 1-2: firma local HS256 con JWT_SECRET.
# Sprint 3: JWT_ALGORITHM=RS256 + resolver la clave por JWKS (kid) contra el emisor real
# del Squad 2 -- eso requiere codigo nuevo (jwks-rsa), no solo cambiar esta config.
JWT_SECRET=dev-only-cambiar-en-produccion
JWT_ISSUER=https://idp.citypass.local
JWT_AUDIENCE=citypass-residuos-api
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=8h

# Emisor de la credencial del chofer (ADR-009). Distinto de JWT_ISSUER a proposito:
# el chofer no se registra ni inicia sesion contra el Squad 2, asi que su token
# nunca deberia decir que viene de ahi.
JWT_ISSUER_CHOFERES=citypass-residuos-choferes

# Origenes habilitados para llamadas desde navegador, separados por coma.
# En produccion no conviene dejar CORS abierto.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# --- Reglas de negocio ---
UMBRAL_CRITICO_DEFAULT_PCT=80
UMBRAL_TEMPERATURA_DEFAULT_C=60
RADIO_CONFIRMACION_VACIADO_METROS=100

# CU-INT-02: auto denunciado que tapa un contenedor.
OBSTRUCCION_RADIO_METROS=15
OBSTRUCCION_VIGENCIA_HORAS=4
