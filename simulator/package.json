{
  "name": "citypass-residuos-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulador de sensores IoT del modulo de Residuos (CU-04)",
  "scripts": {
    "seed": "node seed.js",
    "start": "node simulador.js",
    "saturacion": "node simulador.js --escenario saturacion",
    "incendio": "node simulador.js --escenario incendio",
    "emergencia-residuos": "node emergencia.js --causa RESIDUOS",
    "emergencia-via": "node emergencia.js --causa VIA",
    "actividad": "node actividad-masiva.js",
    "bus": "node bus.js",
    "reclamo": "node reclamo.js",
    "reclamo:resuelto": "node reclamo.js resuelto"
  }
}
